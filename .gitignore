# build output
dist/
# build artifacts written by integration.ts at build time
.versions
.product-configs/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

*.tar.zst

zarf-sbom/

.vscode/
.idea/

# temp folder
temp/
# Local Netlify folder
.netlify/

# LikeC4 model directories (cloned from upstream)
.c4/

# All content under src/content/docs/ is generated at build time — ignore entirely.
# Exception: the root-level 404 page is hand-maintained (contains product-aware JS)
# and must remain tracked in git.
src/content/docs/*
!src/content/docs/404.md

# Playwright
test-results/
playwright-report/
