{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "promql",
  "scopeName": "source.promql",
  "fileTypes": ["promql"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#aggregations" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#metric_name" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.promql",
      "match": "#.*$"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.promql",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.promql", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.promql",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.promql", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.backtick.promql",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "aggregations": {
      "name": "keyword.control.promql",
      "match": "\\b(sum|avg|min|max|stddev|stdvar|count|count_values|bottomk|topk|quantile|group)\\b"
    },
    "functions": {
      "name": "entity.name.function.promql",
      "match": "\\b(abs|absent|absent_over_time|ceil|changes|clamp|clamp_max|clamp_min|day_of_month|day_of_week|day_of_year|days_in_month|delta|deriv|exp|floor|histogram_count|histogram_fraction|histogram_quantile|histogram_sum|holt_winters|hour|idelta|increase|irate|label_join|label_replace|ln|log2|log10|minute|month|predict_linear|rate|resets|round|scalar|sgn|sort|sort_desc|sort_by_label|sort_by_label_desc|sqrt|time|timestamp|vector|year|avg_over_time|min_over_time|max_over_time|sum_over_time|count_over_time|quantile_over_time|stddev_over_time|stdvar_over_time|mad_over_time|last_over_time|present_over_time|double_exponential_smoothing|info|limit_ratio)\\b(?=\\s*\\()"
    },
    "keywords": {
      "name": "keyword.operator.promql",
      "match": "\\b(by|without|on|ignoring|group_left|group_right|bool|or|and|unless|offset)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.promql",
          "match": "\\b[0-9]+(ms|s|m|h|d|w|y)\\b"
        },
        {
          "name": "constant.numeric.promql",
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.language.promql",
          "match": "\\b(Inf|NaN)\\b"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.promql",
      "match": "(=~|!~|!=|==|>=|<=|>|<|\\+|-|\\*|/|%|\\^)"
    },
    "metric_name": {
      "name": "entity.name.tag.promql",
      "match": "\\b[a-zA-Z_:][a-zA-Z0-9_:]*\\b"
    }
  }
}
