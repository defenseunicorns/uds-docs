{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "logql",
  "scopeName": "source.logql",
  "fileTypes": ["logql"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#aggregations" },
    { "include": "#range_functions" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#pipeline_operators" },
    { "include": "#operators" },
    { "include": "#labels" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.logql",
      "match": "#.*$"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.logql",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.logql", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.logql",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.logql", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.backtick.logql",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "aggregations": {
      "name": "keyword.control.logql",
      "match": "\\b(sum|avg|min|max|stddev|stdvar|count|count_values|bottomk|topk|quantile)\\b"
    },
    "range_functions": {
      "name": "entity.name.function.logql",
      "match": "\\b(rate|count_over_time|bytes_rate|bytes_over_time|absent_over_time|sum_over_time|avg_over_time|max_over_time|min_over_time|first_over_time|last_over_time|quantile_over_time|stdvar_over_time|stddev_over_time)\\b(?=\\s*\\()"
    },
    "keywords": {
      "name": "keyword.operator.logql",
      "match": "\\b(by|without|on|ignoring|group_left|group_right|bool|or|and|unless|offset|keep|drop|label_format|line_format|unwrap|convert|decolorize|unpack|json|logfmt|pattern|regexp|line)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.logql",
          "match": "\\b[0-9]+(ms|s|m|h|d|w|y)\\b"
        },
        {
          "name": "constant.numeric.logql",
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "pipeline_operators": {
      "name": "keyword.operator.pipeline.logql",
      "match": "(\\|=|\\|~|!=|!~|\\|>|\\|)"
    },
    "operators": {
      "name": "keyword.operator.logql",
      "match": "(=~|!=|>=|<=|>|<|=|\\+|-|\\*|/|%|\\^)"
    },
    "labels": {
      "name": "variable.other.label.logql",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*[=!~,}])"
    }
  }
}
