---
// src/pages/fleet/index.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Card, CardGrid } from '@astrojs/starlight/components';
import '@fontsource/teko';

const frontmatter = {
  title: "Fleet",
  description: "Fleet docs overview",
  template: "splash",
  hero: {
    title: "Fleet",
    tagline: "Manage your fleet with UDS.",
    image: { html: '<img src="/assets/doug.svg" alt="Doug the Unicorn" class="hero-logo" />' }
  },
  prev: false,
  next: false
} as const;
---

<style>
    :root[data-theme='light'] {
        h1, h2 {
            font-family: "Teko", sans-serif;
            color: #122248;
        }
    }

    :root[data-theme='dark'] {
        h1, h2 {
            font-family: "Teko", sans-serif;
            color: rgba(36,176,255);
        }

        .card {
            background-color: rgb(31 41 55);
        }
    }

    html:where([data-has-sidebar]) {
        --sl-content-width: 67.5rem;

        .card > .body ul {
            list-style: none outside none;
            padding: 0;
        }

        .hero {
            display: grid;
            align-items: center;
            gap: 1rem;
            padding-bottom: 1rem;
            padding-top: 1rem;
        }

        .hero > img,
        .hero > .hero-html {
            object-fit: contain;
            width: min(60%, 20rem);
            height: auto;
            margin-inline: auto;
        }

        .hero-logo {
            max-height: 232.4px;
            width: 100%;
            height: auto;
            display: block;
            margin: 0 auto;
        }

        .stack {
            text-align: center;
            align-items: center;
        }

        .copy {
            text-align: left;
            font-family: "Teko", sans-serif;
            gap: 0;
        }

        .copy > * {
            max-width: 80ch;
        }

        .copy > .tagline {
            font-size: 24px;
            line-height: 2rem;
        }

        @media (min-width: 70rem) {
            .card-grid {
                grid-template-columns: 1fr 1fr;
                gap: 1.5rem;
            }
        }

        @media (max-width: 50rem) {
            .hero {
                img {
                    width: 10rem;
                }
            }

            .copy {
                font-size: 32px;
                font-family: "Teko", sans-serif;
                gap: 0;
            }

            .copy > .tagline {
                font-size: 20px;
                text-align: center;
                line-height: 2rem;
            }
        }
    }
    /* Badge styles added inline, matching Starlight's sidebar */
    .sl-badge.tip {
        display: inline-block;
        border: 1px solid hsl(281, 82%, 63%); /* Exact border */
        border-radius: 0.25rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        line-height: normal; /* Match sidebar line height */
        color: #fff;
        background-color: hsl(281, 39%, 22%);
        overflow-wrap: anywhere;
        font-size: 0.8125rem;
        padding: 0.125rem 0.375rem;
        margin-left: 0.5rem;
    }

    .sl-badge.small {
        padding: 0.2rem 0.5rem; /* Adjusted padding */
    }

    .doc-links {
        list-style: none;
        padding: 0;
        margin: 0.75rem 0 0;
        display: grid;
        gap: 0.35rem;
    }

    .doc-links a {
        text-decoration: none;
    }

    .doc-links a:hover {
        text-decoration: underline;
    }

    .callout-stack {
        margin-top: 1.25rem;
        display: grid;
        gap: 0.45rem;
    }

    .callout {
        padding: 0.9rem 1rem;
        border: 1px solid var(--sl-color-hairline, #e5e7eb);
        border-radius: 0.75rem;
        font-size: 0.95rem;
        background: var(--sl-color-bg-alt, rgba(17,24,39,0.5));
    }

    .callout-links {
        list-style: none;
        padding: 0;
        margin: 0.4rem 0 0;
        display: grid;
        gap: 0.3rem;
        font-size: 0.93rem;
    }

    .icon-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
        font-weight: 600;
    }

    .icon-link:hover {
        text-decoration: underline;
    }

    .icon-link svg {
        width: 1rem;
        height: 1rem;
        display: inline-block;
    }

    :global(.content-panel) {
        padding: 0rem var(--sl-content-pad-x);
    }
</style>

<StarlightPage frontmatter={frontmatter} hasSidebar={true}>
  <div class="space-y-8">
    <CardGrid>
      <Card title="Overview">
        <p>Intro copy for Fleet.</p>
      </Card>
            <Card title="Getting Started">
                <p>Choose a path to try UDS Core in a demo or production-like environment.</p>
                <ul class="doc-links">
                    <li>
                        <a class="no-underline" href="/getting-started/local-demo/overview/">Local demo (quickstart)</a>
                    </li>
                    <li>
                        <a class="no-underline" href="/getting-started/production/overview/">Production deployments</a>
                    </li>
                </ul>
            </Card>

            <Card title="Concepts & How‑to Guides">
                <p>Learn how UDS Core works, then apply it with task-focused guides.</p>
                <ul class="doc-links">
                    <li>
                        <a class="no-underline" href="/concepts/overview/">Concepts overview</a>
                    </li>
                    <li>
                        <a class="no-underline" href="/how-to-guides/overview/">How‑to Guides overview</a>
                    </li>
                </ul>
            </Card>

            <Card title="Operations & Reference">
                <p>Operate UDS Core over time and look up exact configuration details.</p>
                <ul class="doc-links">
                    <li>
                        <a class="no-underline" href="/operations/overview/">Operations & Maintenance overview</a>
                    </li>
                    <li>
                        <a class="no-underline" href="/reference/overview/">Reference overview</a>
                    </li>
                </ul>
            </Card>
    </CardGrid>
  </div>
</StarlightPage>