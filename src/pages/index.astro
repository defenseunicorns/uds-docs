---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Card, CardGrid } from '@astrojs/starlight/components';
import '@fontsource/teko';

const frontmatter = {
    title: "Unicorn Delivery Service",
    description: "Explore UDS (Unicorn Delivery Service), a secure, standards-based software delivery system for National Security missions.",
    template: "splash",
    prev: false,
    next: false
} as const;

---
<style>
    /* Hide the auto-generated page title */
    :global(.main-pane .content-panel:has(h1#_top)) {
        display: none;
    }
    :global(.main-pane .content-panel:has(h1#_top) + .content-panel) {
        border-top: none;
    }

    .custom-hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 2rem 0 1.5rem;
    }

    .custom-hero .tagline {
        font-family: 'Teko', sans-serif;
        font-size: 2rem;
        line-height: 1.75rem;
        margin-top: 1rem;
        color: var(--sl-color-gray-2);
    }

    :root[data-theme='light'] {
        h2 {
            font-family: "Teko", sans-serif;
            color: #122248;
        }
    }

    :root[data-theme='dark'] {
        h2 {
            font-family: "Teko", sans-serif;
            color: rgba(36,176,255);
        }
    }

    @media (max-width: 50rem) {
        .custom-hero .hero-logo {
            max-width: 18rem;
        }
        .custom-hero .tagline {
            font-size: 1.1rem;
        }
    }

    .section-divider {
        border: none;
        border-top: 1px solid var(--sl-color-hairline);
        margin: 2rem 0;
    }

    .card-logo {
        height: 2.5rem;
        width: auto;
        margin-bottom: 0.5rem;
        display: block;
    }

    .card-logo.card-logo-light { display: none; }
    .card-logo.card-logo-dark { display: block; }

    :root[data-theme='light'] {
        .card-logo.card-logo-light { display: block; }
        .card-logo.card-logo-dark { display: none; }
    }

    .callout-stack {
        margin-top: 1.25rem;
        display: grid;
        gap: 0.45rem;
    }

    .callout {
        padding: 0.9rem 1rem;
        border: 1px solid var(--sl-color-hairline);
        border-radius: 0.75rem;
        font-size: 0.95rem;
        background: var(--sl-color-card);
    }

    .callout-links {
        list-style: none;
        padding: 0;
        margin: 0.4rem 0 0;
        display: grid;
        gap: 0.3rem;
        font-size: 0.93rem;
    }

    /* Stretch-link: makes the whole card clickable */
    :global(.card:has(.card-link)) {
        position: relative;
        cursor: pointer;
        transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    :global(.card:has(.card-link):hover) {
        border-color: var(--sl-color-text-accent);
        background-color: var(--sl-color-card-muted);
    }

    .card-link {
        position: absolute;
        inset: 0;
        border-radius: inherit;
    }

    :global(.content-panel) {
        padding: 0rem var(--sl-content-pad-x);
    }
</style>

<StarlightPage frontmatter={frontmatter} hasSidebar={false}>
    <div class="custom-hero">
        <h1 class="sr-only">Unicorn Delivery Service</h1>
        <img src="/assets/UDS_Logo_White.svg" alt="Unicorn Delivery Service" class="hero-logo hero-logo-dark" />
        <img src="/assets/UDS_Logo_Dark.svg" alt="Unicorn Delivery Service" class="hero-logo hero-logo-light" />
        <p class="tagline">A secure software delivery platform built for National Security missions.</p>
    </div>

    <p>
        UDS (Unicorn Delivery Service) is a software delivery platform built for teams operating in secure,
        constrained, or disconnected environments. It addresses a common challenge in defense and enterprise
        computing: getting modern software with all its dependencies into environments where internet access is
        limited or absent, compliance requirements are strict, and one-off platform configurations are a constant
        maintenance burden.
    </p>

    <p>
        UDS provides a consistent, repeatable way to package, deliver, and run software across cloud, on-premises,
        and tactical edge environments. Whether you are standing up a new system quickly, maintaining an existing
        platform through software updates, or seeking an Authority to Operate (ATO), UDS gives teams the tooling
        and evidence to do so with confidence.
    </p>

    <ul>
        <li><strong>Deploy anywhere</strong> - Ship software to classified and unclassified cloud, on-premises, and edge environments from a single artifact.</li>
        <li><strong>Work disconnected</strong> - Operate fully offline with airgap-native packaging that carries all dependencies with it.</li>
        <li><strong>Reduce platform one-offs</strong> - Share a common runtime baseline so application teams do not need to reinvent platform concerns for each deployment.</li>
        <li><strong>Support authorization</strong> - Produce the compliance documentation and evidence needed to facilitate ATO processes.</li>
        <li><strong>Stay vendor-neutral</strong> - Build on open-source foundations (Zarf, Pepr) with no proprietary lock-in.</li>
    </ul>

    <hr class="section-divider" />

    <h2>Key Building Blocks</h2>

    <CardGrid>
        <Card title="">
            <img src="/assets/UDS_Core_Logo_White.svg" alt="UDS Core" class="card-logo card-logo-dark" />
            <img src="/assets/UDS_Core_Logo_Dark.svg" alt="UDS Core" class="card-logo card-logo-light" />
            The runtime platform that provides shared, security-hardened services to every application deployed on top of it. Handles networking, identity, logging, monitoring, runtime security, and compliance.
            <a href="/core/" class="card-link" aria-label="UDS Core"></a>
        </Card>

        <Card title="">
            <img src="/assets/UDS_CLI_Logo_White.svg" alt="UDS CLI" class="card-logo card-logo-dark" />
            <img src="/assets/UDS_CLI_Logo_Dark.svg" alt="UDS CLI" class="card-logo card-logo-light" />
            The primary interface for packaging, deploying, and managing software on UDS Core. Designed for workflows from local development to production operations.
            <a href="/cli/" class="card-link" aria-label="UDS CLI"></a>
        </Card>

        <Card title="">
            <img src="/assets/UDS_Registry_Logo_White.svg" alt="UDS Registry" class="card-logo card-logo-dark" />
            <img src="/assets/UDS_Registry_Logo_Dark.svg" alt="UDS Registry" class="card-logo card-logo-light" />
            A curated catalog of pre-built, scanned, and SBOMed UDS packages. Browse available packages, inspect CVE reports, and pull artifacts to deploy.
            <a href="https://registry.defenseunicorns.com/" class="card-link" aria-label="UDS Registry" target="_blank" rel="noopener noreferrer"></a>
        </Card>

        <Card title="Open-Source Foundation">
            UDS is built on open-source projects created by Defense Unicorns:
            <p><strong><a href="https://docs.zarf.dev/" target="_blank">Zarf</a></strong> — airgap packaging and delivery for Kubernetes workloads.</p>
            <p><strong><a href="https://docs.pepr.dev/" target="_blank">Pepr</a></strong> — policy engine and Kubernetes operator automation.</p>
        </Card>
    </CardGrid>

    <hr class="section-divider" />

    <div class="callout-stack">
        <div class="callout">
            <strong>Docs for LLMs:</strong> machine-readable snapshots for assistants and automation.
            <ul class="callout-links">
                <li><a href="/llms.txt">llms.txt</a> — listing of available files</li>
                <li><a href="/llms-full.txt">llms-full.txt</a> — complete documentation for UDS</li>
                <li><a href="/llms-small.txt">llms-small.txt</a> — compressed documentation for smaller context windows</li>
            </ul>
        </div>
    </div>
</StarlightPage>
