---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Card, CardGrid, LinkCard } from '@astrojs/starlight/components';
import '@fontsource/teko';

const frontmatter = {
    title: "Unicorn Delivery Service",
    description: "Explore guides and tutorials for the Unicorn Delivery Service platform",
    template: "splash",
    hero: {
        title: "Unicorn Delivery Service",
        tagline: "A secure software delivery product built for National Security missions.",
        image: {
            html: '<img src="/assets/doug.svg" alt="Doug the Unicorn" class="hero-logo" />'
        }
    },
    prev: false,
    next: false
} as const;

---
<style>
    :root[data-theme='light'] {
        h1, h2 {
            font-family: "Teko", sans-serif;
            color: #122248;
        }
    }

    :root[data-theme='dark'] {
        h1, h2 {
            font-family: "Teko", sans-serif;
            color: rgba(36,176,255);
        }

        .card {
            background-color: rgb(31 41 55);
        }
    }

    html:where([data-has-sidebar]) {
        --sl-content-width: 67.5rem;

        .card > .body ul {
            list-style: none outside none;
            padding: 0;
        }

        .hero {
            display: grid;
            align-items: center;
            gap: 1rem;
            padding-bottom: 1rem;
            padding-top: 1rem;
        }

        .hero > img,
        .hero > .hero-html {
            object-fit: contain;
            width: min(60%, 20rem);
            height: auto;
            margin-inline: auto;
        }

        .hero-logo {
            max-height: 232.4px;
            width: 100%;
            height: auto;
            display: block;
            margin: 0 auto;
        }

        .stack {
            text-align: center;
            align-items: center;
        }

        .copy {
            text-align: left;
            font-family: "Teko", sans-serif;
            gap: 0;
        }

        .copy > * {
            max-width: 80ch;
        }

        .copy > .tagline {
            font-size: 24px;
            line-height: 2rem;
        }

        @media (min-width: 70rem) {
            .card-grid {
                grid-template-columns: 1fr 1fr;
                gap: 1.5rem;
            }
        }

        @media (max-width: 50rem) {
            .hero {
                img {
                    width: 10rem;
                }
            }

            .copy {
                font-size: 32px;
                font-family: "Teko", sans-serif;
                gap: 0;
            }

            .copy > .tagline {
                font-size: 20px;
                text-align: center;
                line-height: 2rem;
            }
        }
    }
    /* Badge styles added inline, matching Starlight's sidebar */
    .sl-badge.tip {
        display: inline-block;
        border: 1px solid hsl(281, 82%, 63%); /* Exact border */
        border-radius: 0.25rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        line-height: normal; /* Match sidebar line height */
        color: #fff;
        background-color: hsl(281, 39%, 22%);
        overflow-wrap: anywhere;
        font-size: 0.8125rem;
        padding: 0.125rem 0.375rem;
        margin-left: 0.5rem;
    }

    .sl-badge.small {
        padding: 0.2rem 0.5rem; /* Adjusted padding */
    }
</style>

<StarlightPage frontmatter={frontmatter} hasSidebar={true}>
    <div class="space-y-8">
        <CardGrid>
            <Card title="Learn more about UDS">
                <p>Understand why UDS exists and how it supports secure delivery missions.</p>
                <LinkCard title="Why UDS" href="/overview/why-uds/" />
                <LinkCard title="Mission Relevance" href="/overview/uds-mission-relevance/" />
            </Card>

            <Card title="Get started with UDS">
                <p>Install UDS CLI and UDS Core on your local machine.</p>
                <LinkCard title="Basic Requirements" href="/getting-started/basic-requirements/" />
                <LinkCard title="Install & Deploy" href="/getting-started/install-and-deploy-uds/" />
            </Card>

            <Card title="UDS Core">
                <p>Explore UDS Core, then integrate and deploy an application with Core.</p>
                <LinkCard title="UDS Core Overview" href="/reference/uds-core/overview/" />
                <LinkCard title="Deploy with UDS Core" href="/tutorials/deploy-with-uds-core/" />
            </Card>

            <Card title="Product Capabilities">
                <p>Learn more about UDS at the Tactical Edge and the UDS Registry.</p>
                <LinkCard title="Tactical Edge" href="/tactical-edge-deployments/overview/" />
                <LinkCard title="UDS Registry" href="/registry/overview/" />
            </Card>
        </CardGrid>
    </div>
    <div>
        <h2 class="text-left">Get involved</h2>
        <div>
            <Card title="UDS Core">
                <p>
                        UDS Core provides a secure baseline for cloud-native systems and includes compliance documentation with strong support for airgap environments.
                </p>
                    <LinkCard title="Go to UDS Core on GitHub" href="https://github.com/defenseunicorns/uds-core" />
            </Card>
            <Card title="UDS CLI">
                <p>
                        UDS CLI allows bundling and deploying multiple independent Zarf packages efficiently.
                </p>
                    <LinkCard title="Go to UDS CLI on GitHub" href="https://github.com/defenseunicorns/uds-cli" target="_blank" />
            </Card>
            <Card title="Docs for LLMs">
                <p>
                        We support the llms.txt convention for making documentation available to large language models and the applications that make use of them.
                </p>
                <p>
                        Currently, we have the following root-level files:
                </p>
                <ul>
                    <li><a href="/llms.txt" class="no-underline">/llms.txt</a> — a listing of the available files</li>
                    <li><a href="/llms-full.txt" class="no-underline">/llms-full.txt</a> — complete documentation for UDS</li>
                    <li><a href="/llms-small.txt" class="no-underline">/llms-small.txt</a> — compressed documentation for use with smaller context windows</li>
                </ul>
            </Card>
            </div>
        </div>
    </div>
</StarlightPage>
