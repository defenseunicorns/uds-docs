---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Card, CardGrid } from '@astrojs/starlight/components';
import '@fontsource/teko';

const frontmatter = {
    title: "Unicorn Delivery Service",
    description: "Explore guides and tutorials for the Unicorn Delivery Service platform",
    template: "splash",
    hero: {
        title: "Unicorn Delivery Service",
        tagline: "A secure software delivery product built for National Security missions.",
        image: {
            html: '<img src="/assets/doug.svg" alt="Doug the Unicorn" class="hero-logo" />'
        }
    },
    prev: false,
    next: false
} as const;

---
<style>
    :root[data-theme='light'] {
        h1, h2 {
            font-family: "Teko", sans-serif;
            color: #122248;
        }
    }

    :root[data-theme='dark'] {
        h1, h2 {
            font-family: "Teko", sans-serif;
            color: rgba(36,176,255);
        }

        .card {
            background-color: rgb(31 41 55);
        }
    }

    html:where([data-has-sidebar]) {
        --sl-content-width: 67.5rem;

        .card > .body ul {
            list-style: none outside none;
            padding: 0;
        }

        .hero {
            display: grid;
            align-items: center;
            gap: 1rem;
            padding-bottom: 1rem;
            padding-top: 1rem;
        }

        .hero > img,
        .hero > .hero-html {
            object-fit: contain;
            width: min(60%, 20rem);
            height: auto;
            margin-inline: auto;
        }

        .hero-logo {
            max-height: 232.4px;
            width: 100%;
            height: auto;
            display: block;
            margin: 0 auto;
        }

        .stack {
            text-align: center;
            align-items: center;
        }

        .copy {
            text-align: left;
            font-family: "Teko", sans-serif;
            gap: 0;
        }

        .copy > * {
            max-width: 80ch;
        }

        .copy > .tagline {
            font-size: 24px;
            line-height: 2rem;
        }

        @media (min-width: 70rem) {
            .card-grid {
                grid-template-columns: 1fr 1fr;
                gap: 1.5rem;
            }
        }

        @media (max-width: 50rem) {
            .hero {
                img {
                    width: 10rem;
                }
            }

            .copy {
                font-size: 32px;
                font-family: "Teko", sans-serif;
                gap: 0;
            }

            .copy > .tagline {
                font-size: 20px;
                text-align: center;
                line-height: 2rem;
            }
        }
    }
    /* Badge styles added inline, matching Starlight's sidebar */
    .sl-badge.tip {
        display: inline-block;
        border: 1px solid hsl(281, 82%, 63%); /* Exact border */
        border-radius: 0.25rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        line-height: normal; /* Match sidebar line height */
        color: #fff;
        background-color: hsl(281, 39%, 22%);
        overflow-wrap: anywhere;
        font-size: 0.8125rem;
        padding: 0.125rem 0.375rem;
        margin-left: 0.5rem;
    }

    .sl-badge.small {
        padding: 0.2rem 0.5rem; /* Adjusted padding */
    }

    .doc-links {
        list-style: none;
        padding: 0;
        margin: 0.75rem 0 0;
        display: grid;
        gap: 0.35rem;
    }

    .doc-links a {
        text-decoration: none;
    }

    .doc-links a:hover {
        text-decoration: underline;
    }

    .callout-stack {
        margin-top: 1.25rem;
        display: grid;
        gap: 0.45rem;
    }

    .callout {
        padding: 0.9rem 1rem;
        border: 1px solid var(--sl-color-hairline, #e5e7eb);
        border-radius: 0.75rem;
        font-size: 0.95rem;
        background: var(--sl-color-bg-alt, rgba(17,24,39,0.5));
    }

    .callout-links {
        list-style: none;
        padding: 0;
        margin: 0.4rem 0 0;
        display: grid;
        gap: 0.3rem;
        font-size: 0.93rem;
    }

    .icon-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
        font-weight: 600;
    }

    .icon-link:hover {
        text-decoration: underline;
    }

    .icon-link svg {
        width: 1rem;
        height: 1rem;
        display: inline-block;
    }

    :global(.content-panel) {
        padding: 0rem var(--sl-content-pad-x);
    }
</style>

<StarlightPage frontmatter={frontmatter} hasSidebar={true}>
    <div class="space-y-8">
        <CardGrid>
            <Card title="Learn more about UDS">
                <p>Understand why UDS exists and how it supports secure delivery missions.</p>
                <ul class="doc-links">
                    <li>
                        <a class="no-underline" href="/overview/why-uds/">Why UDS</a>
                    </li>
                    <li>
                        <a class="no-underline" href="/overview/uds-mission-relevance/">Mission Relevance</a>
                    </li>
                </ul>
            </Card>

            <Card title="Get started with UDS">
                <p>Install UDS CLI and UDS Core on your local machine.</p>
                <ul class="doc-links">
                    <li>
                        <a class="no-underline" href="/getting-started/basic-requirements/">Basic Requirements</a>
                    </li>
                    <li>
                        <a class="no-underline" href="/getting-started/install-and-deploy-uds/">Install & Deploy</a>
                    </li>
                </ul>
            </Card>

            <Card title="UDS Core">
                <p>Explore UDS Core, then integrate and deploy an application with Core.</p>
                <ul class="doc-links">
                    <li>
                        <a class="no-underline" href="/reference/uds-core/overview/">UDS Core Overview</a>
                    </li>
                    <li>
                        <a class="no-underline" href="/tutorials/deploy-with-uds-core/">Deploy with UDS Core</a>
                    </li>
                </ul>
            </Card>

            <Card title="Product Capabilities">
                <p>Learn more about UDS at the Tactical Edge and the UDS Registry.</p>
                <ul class="doc-links">
                    <li>
                        <a class="no-underline" href="/tactical-edge-deployments/overview/">Tactical Edge</a>
                    </li>
                    <li>
                        <a class="no-underline" href="/registry/overview/">UDS Registry</a>
                    </li>
                </ul>
            </Card>
        </CardGrid>
    </div>
    <div class="callout-stack">
        <div class="callout involve-callout">
            <strong>Get Involved:</strong>
            <ul class="callout-links">
                <li>
                    <a class="icon-link" href="https://github.com/defenseunicorns/uds-core" target="_blank">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.01.08-2.11 0 0 .67-.21 2.2.82a7.5 7.5 0 0 1 4.01 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.91.08 2.11.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.19 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
                        UDS Core on GitHub
                    </a>
                </li>
                <li>
                    <a class="icon-link" href="https://github.com/defenseunicorns/uds-cli" target="_blank">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.01.08-2.11 0 0 .67-.21 2.2.82a7.5 7.5 0 0 1 4.01 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.91.08 2.11.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.19 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
                        UDS CLI on GitHub
                    </a>
                </li>
            </ul>
        </div>

        <div class="callout llm-callout">
            <strong>Docs for LLMs:</strong> machine-readable snapshots for assistants and automation.
            <ul class="callout-links">
                <li><a href="/llms.txt">llms.txt</a> — listing of available files</li>
                <li><a href="/llms-full.txt">llms-full.txt</a> — complete documentation for UDS</li>
                <li><a href="/llms-small.txt">llms-small.txt</a> — compressed documentation for smaller context windows</li>
            </ul>
        </div>
    </div>
</StarlightPage>
