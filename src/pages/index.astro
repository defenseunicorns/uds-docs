---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Card, CardGrid } from '@astrojs/starlight/components';
import '@fontsource/teko';

const frontmatter = {
    title: "Unicorn Delivery Service",
    description: "Explore guides and tutorials for the Unicorn Delivery Service platform",
    template: "splash",
    prev: false,
    next: false
} as const;

---
<style>
    /* Hide the auto-generated page title and its divider since our logo replaces it */
    :global(.main-pane .content-panel:has(h1#_top)) {
        display: none;
    }
    :global(.main-pane .content-panel:has(h1#_top) + .content-panel) {
        border-top: none;
    }

    /* Custom hero */
    .custom-hero {
        text-align: center;
        padding: 2rem 0 1.5rem;
    }

    .custom-hero .hero-logo {
        max-width: 28rem;
        width: 100%;
        height: auto;
        margin: 0 auto;
    }

    .custom-hero .tagline {
        font-family: 'Teko', sans-serif;
        font-size: 2rem;
        line-height: 1.75rem;
        margin-top: 1rem;
        color: var(--sl-color-gray-2);
    }

    /* Theme-aware hero logo */
    .hero-logo-light { display: none; }
    .hero-logo-dark { display: block; }

    :root[data-theme='light'] {
        h2 {
            font-family: "Teko", sans-serif;
            color: #122248;
        }

        .hero-logo-light { display: block; }
        .hero-logo-dark { display: none; }
    }

    :root[data-theme='dark'] {
        h2 {
            font-family: "Teko", sans-serif;
            color: rgba(36,176,255);
        }
    }

    html:where([data-has-sidebar]) {
        --sl-content-width: 67.5rem;

        .card > .body ul {
            list-style: none outside none;
            padding: 0;
        }

        @media (min-width: 70rem) {
            .card-grid {
                grid-template-columns: 1fr 1fr;
                gap: 1.5rem;
            }
        }

        @media (max-width: 50rem) {
            .custom-hero .hero-logo {
                max-width: 18rem;
            }

            .custom-hero .tagline {
                font-size: 1.1rem;
            }
        }
    }
    /* Badge styles added inline, matching Starlight's sidebar */
    .sl-badge.tip {
        display: inline-block;
        border: 1px solid hsl(281, 82%, 63%); /* Exact border */
        border-radius: 0.25rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        line-height: normal; /* Match sidebar line height */
        color: #fff;
        background-color: hsl(281, 39%, 22%);
        overflow-wrap: anywhere;
        font-size: 0.8125rem;
        padding: 0.125rem 0.375rem;
        margin-left: 0.5rem;
    }

    .sl-badge.small {
        padding: 0.2rem 0.5rem; /* Adjusted padding */
    }

    .doc-links {
        list-style: none;
        padding: 0;
        margin: 0.75rem 0 0;
        display: grid;
        gap: 0.35rem;
    }

    .doc-links a {
        text-decoration: none;
    }

    .doc-links a:hover {
        text-decoration: underline;
    }

    .callout-stack {
        margin-top: 1.25rem;
        display: grid;
        gap: 0.45rem;
    }

    .callout {
        padding: 0.9rem 1rem;
        border: 1px solid var(--sl-color-hairline);
        border-radius: 0.75rem;
        font-size: 0.95rem;
        background: var(--sl-color-card);
    }

    .callout-links {
        list-style: none;
        padding: 0;
        margin: 0.4rem 0 0;
        display: grid;
        gap: 0.3rem;
        font-size: 0.93rem;
    }

    .icon-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
        font-weight: 600;
    }

    .icon-link:hover {
        text-decoration: underline;
    }

    .icon-link svg {
        width: 1rem;
        height: 1rem;
        display: inline-block;
    }

    :global(.content-panel) {
        padding: 0rem var(--sl-content-pad-x);
    }
</style>

<StarlightPage frontmatter={frontmatter} hasSidebar={true}>
    <div class="custom-hero">
        <h1 class="sr-only">UDS Core</h1>
        <img src="/assets/UDS_Core_Logo_White.svg" alt="UDS Core" class="hero-logo hero-logo-dark" />
        <img src="/assets/UDS_Core_Logo_Dark.svg" alt="UDS Core" class="hero-logo hero-logo-light" />
        <p class="tagline">A secure software delivery product built for National Security missions.</p>
    </div>
    <div class="space-y-8">
        <CardGrid>
            <Card title="Overview">
                <p>Start here to understand what UDS Core is and why it exists.</p>
                <ul class="doc-links">
                    <li>
                        <a class="no-underline" href="/ecosystem/">Overview of UDS</a>
                    </li>
                    <li>
                        <a class="no-underline" href="/uds-core/">UDS Core overview</a>
                    </li>
                </ul>
            </Card>

            <Card title="Getting Started">
                <p>Choose a path to try UDS Core in a demo or production-like environment.</p>
                <ul class="doc-links">
                    <li>
                        <a class="no-underline" href="/getting-started/local-demo/overview/">Local demo (quickstart)</a>
                    </li>
                    <li>
                        <a class="no-underline" href="/getting-started/production/overview/">Production deployments</a>
                    </li>
                </ul>
            </Card>

            <Card title="Concepts & How‑to Guides">
                <p>Learn how UDS Core works, then apply it with task-focused guides.</p>
                <ul class="doc-links">
                    <li>
                        <a class="no-underline" href="/concepts/overview/">Concepts overview</a>
                    </li>
                    <li>
                        <a class="no-underline" href="/how-to-guides/overview/">How‑to Guides overview</a>
                    </li>
                </ul>
            </Card>

            <Card title="Operations & Reference">
                <p>Operate UDS Core over time and look up exact configuration details.</p>
                <ul class="doc-links">
                    <li>
                        <a class="no-underline" href="/operations/overview/">Operations & Maintenance overview</a>
                    </li>
                    <li>
                        <a class="no-underline" href="/reference/overview/">Reference overview</a>
                    </li>
                </ul>
            </Card>
        </CardGrid>
    </div>
    <div class="callout-stack">
        <div class="callout involve-callout">
            <strong>Get Involved:</strong>
            <ul class="callout-links">
                <li>
                    <a class="icon-link" href="https://github.com/defenseunicorns/uds-core" target="_blank">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.01.08-2.11 0 0 .67-.21 2.2.82a7.5 7.5 0 0 1 4.01 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.91.08 2.11.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.19 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
                        UDS Core on GitHub
                    </a>
                </li>
            </ul>
        </div>

        <div class="callout llm-callout">
            <strong>Docs for LLMs:</strong> machine-readable snapshots for assistants and automation.
            <ul class="callout-links">
                <li><a href="/llms.txt">llms.txt</a> — listing of available files</li>
                <li><a href="/llms-full.txt">llms-full.txt</a> — complete documentation for UDS</li>
                <li><a href="/llms-small.txt">llms-small.txt</a> — compressed documentation for smaller context windows</li>
            </ul>
        </div>
    </div>
</StarlightPage>
