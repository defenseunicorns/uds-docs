---
// Version picker is hidden by default to avoid FOUC; the client-side script
// shows it when the current product has multiple available channels or versions.
---

<div class="version-picker not-content" style="display:none">
  <label for="version-select" class="version-label">Version</label>
  <select id="version-select" class="version-select">
    <option value="main">MAIN</option>
    <option value="latest">Latest</option>
  </select>
</div>

<style>
  .version-picker {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .version-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }
  .version-select {
    font-size: 0.8125rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    height: 2rem;
  }
  .version-select:focus {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
</style>

<script>
  import {
    productHasMain,
    productLatestVersions,
    productVersions,
    detectMainPath,
    detectProduct,
    detectVersionSlug,
  } from '../productUtils';

  function initVersionPicker() {
    const select = document.getElementById('version-select') as HTMLSelectElement;
    if (!select || select.dataset.initialized) return;
    select.dataset.initialized = 'true';

    const product = detectProduct(window.location.pathname);
    if (!product) {
      // no matching product — stay hidden
      return;
    }

    const versions = productVersions[product.id] ?? [];
    const latest = productLatestVersions[product.id];
    const hasMain = productHasMain[product.id] === true;
    const versionOptions = versions.filter(ver => !hasMain || latest?.slug !== ver.slug);
    const optionCount = Number(hasMain) + Number(Boolean(latest)) + versionOptions.length;
    if (optionCount < 2) {
      // No meaningful choice to show when this is the only available version.
      return;
    }

    // Show the picker (hidden by default to prevent FOUC)
    const picker = select.closest('.version-picker') as HTMLElement | null;
    if (picker) picker.style.display = '';

    const mainOption = select.querySelector('option[value="main"]') as HTMLOptionElement | null;
    if (!hasMain) mainOption?.remove();

    const latestOption = select.querySelector('option[value="latest"]') as HTMLOptionElement | null;
    if (!latest) {
      latestOption?.remove();
    } else if (latestOption) {
      latestOption.textContent = `Latest (${latest.display.replace(/^v/, '')})`;
    }

    // Populate version options
    versionOptions.forEach(ver => {
      const opt = document.createElement('option');
      opt.value = ver.slug;
      opt.textContent = ver.display;
      select.appendChild(opt);
    });

    // Set current value
    const currentSlug = detectVersionSlug(window.location.pathname, product);
    select.value = detectMainPath(window.location.pathname, product)
      ? 'main'
      : currentSlug && latest?.slug === currentSlug
        ? 'latest'
        : currentSlug ?? 'latest';

    select.addEventListener('change', () => {
      const selected = select.value;
      const prefix = product.link;
      // Strip the current version prefix from the path
      const afterPrefix = window.location.pathname.startsWith(prefix)
        ? window.location.pathname.slice(prefix.length)
        : window.location.pathname;
      const strippedPath = afterPrefix.replace(/^(?:main|v\d+-\d+)\//, '');

      const target = selected === 'main'
        ? `${prefix}main/${strippedPath}`
        : selected === 'latest' && latest && hasMain
          ? `${prefix}${latest.slug}/${strippedPath}`
          : selected && selected !== 'latest'
            ? `${prefix}${selected}/${strippedPath}`
            : `${prefix}${strippedPath}`;

      // Navigate directly to the target URL via full page reload.
      // Version switching changes sidebar structure, so a full reload is intentional.
      window.location.href = target;
    });
  }

  // Re-initialize on each navigation (Client Router swaps the header DOM,
  // so the old select element and its listeners are gone).
  document.addEventListener('astro:page-load', initVersionPicker);
</script>
