---
import Default from '@astrojs/starlight/components/Sidebar.astro';
import TopicsDropdown from 'starlight-sidebar-topics-dropdown/TopicsDropdown.astro';

const isPageWithTopic = Astro.locals.starlightSidebarTopics?.isPageWithTopic ?? false;
---

{/* Render the topics dropdown menu only when the page belongs to a topic. */}
{isPageWithTopic && (
  <div class="starlight-sidebar-topics-dropdown-container">
    <div class="starlight-sidebar-topics-dropdown-title">Choose a product</div>
    <TopicsDropdown />
  </div>
)}

{/* Render the default sidebar. */}
<Default><slot /></Default>

{/* Override the default gap in the sidebar content with higher specificity */}
<style>
  .starlight-sidebar-topics-dropdown-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .starlight-sidebar-topics-dropdown-dropdown {
    position: relative;
    display: block;
    width: calc(100% - 2 * 2px);
    margin-inline: 2px;
    margin-top: 0;
  }

  /* Override starlight-sidebar-topics-dropdown plugin styles — !important required
     because the plugin injects its own styles with high specificity. */
  :global(.starlight-sidebar-topics-dropdown-menu) {
    background-color: var(--sl-color-bg) !important;
    border: 1px solid var(--sl-color-gray-5) !important;
  }

  :global(.starlight-sidebar-topics-dropdown-button:hover) {
    background-color: var(--sl-color-gray-5) !important;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  }

  :global(.starlight-sidebar-topics-dropdown-item:hover) {
    background-color: var(--sl-color-gray-4) !important;
    transform: translateX(4px);
    border-radius: 0.25rem;
  }

  :global(nav details summary.overview-section-active),
  :global(nav details summary.overview-section-active:hover),
  :global(nav details summary.overview-section-active:focus) {
    background-color: var(--sl-color-text-accent) !important;
    border-radius: 0.25rem;
  }

  :global(nav details summary.overview-section-active .group-label span) {
    color: var(--sl-color-text-invert);
    font-weight: 600;
  }

  :global(nav details summary.overview-section-active .caret) {
    color: var(--sl-color-text-invert);
  }

</style>

<script is:inline data-astro-rerun>
  // Remove versioned topics from the product dropdown — versions use the VersionPicker instead.
  // Runs immediately so there's no flash of versioned items in the dropdown.
  // Note: version slug pattern must match VERSION_SLUG_PATTERN in productUtils.ts
  // and VERSION_SEGMENT_RE in 404.md.
  (() => {
    const versionPattern = /\/v\d+-\d+(?:\/|$)/;
    document.querySelectorAll('.starlight-sidebar-topics-dropdown-menu a').forEach(a => {
      if (versionPattern.test(a.getAttribute('href') || '')) {
        a.remove();
      }
    });
  })();
</script>

<script is:inline data-astro-rerun>
  (() => {
    // Sidebar group labels (e.g. "Getting Started") navigate to the section's overview page
    // when clicked, rather than just toggling the group open/closed. This set defines which
    // URL slugs count as "overview" pages. Case variants handle renamed directories from
    // the integration script's title-casing step.
    const OVERVIEW_SLUGS = new Set(["overview", "Overview", "index", "Index"]);
    const strip = (href) => href.split("#")[0].split("?")[0];

    const isInsideNestedDetails = (detailsEl, linkEl) => {
      const closestDetails = linkEl.closest("details");
      return closestDetails && closestDetails !== detailsEl;
    };

    // Returns the overview/index href if one exists at THIS group level (including hidden items).
    // Returns null if no overview exists — callers must handle this case gracefully.
    const findOverviewHref = (detailsEl) => {
      const linkEls = Array.from(detailsEl.querySelectorAll("a[href]")).filter(
        (a) => !isInsideNestedDetails(detailsEl, a)
      );

      const hrefs = linkEls.map((a) => a.getAttribute("href")).filter(Boolean);

      for (const href of hrefs) {
        const parts = strip(href).split("/").filter(Boolean);
        const last = parts[parts.length - 1];
        if (last && OVERVIEW_SLUGS.has(last)) return href;
      }

      return null;
    };

    const applyOverviewBehavior = () => {
      const nav = document.querySelector("nav");
      if (!nav) return;
      // Clear any stale active highlights before re-applying for the current route.
      nav.querySelectorAll("summary.overview-section-active").forEach((s) => {
        s.classList.remove("overview-section-active");
      });
      const currentPath = strip(window.location.pathname);
      const currentParts = currentPath.split("/").filter(Boolean);
      const currentLast = currentParts[currentParts.length - 1];
      const isOnOverview = Boolean(currentLast && OVERVIEW_SLUGS.has(currentLast));
      const normalize = (p) => strip(p).replace(/\/$/, "");
      nav.querySelectorAll("a[href]").forEach((link) => {
        const href = strip(link.getAttribute("href") || "");
        const parts = href.split("/").filter(Boolean);
        const last = parts[parts.length - 1];
        if (!last || !OVERVIEW_SLUGS.has(last)) return;
        // Hide the sidebar list item for this overview link
        const li = link.closest("li");
        if (li) li.style.display = "none";
        // Highlight parent section when on this overview page
        if (isOnOverview && normalize(href) === normalize(currentPath)) {
          const details = link.closest("details");
          if (details) {
            const summary = details.querySelector(":scope > summary");
            if (summary) summary.classList.add("overview-section-active");
          }
        }
      });
    };

    // Run immediately — the nav is already in the DOM since this script
    // executes after <Default> renders the sidebar HTML. This avoids the
    // flash-of-overview-item that occurs if we wait for DOMContentLoaded.
    applyOverviewBehavior();

    const onReady = () => {
      const nav = document.querySelector("nav");
      if (!nav) return;

      // Only the label text navigates; clicking anywhere else on the row just toggles.
      // Keyboard accessible: <summary> fires click on Enter/Space natively.
      nav.addEventListener(
        "click",
        (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

          const summary = e.target instanceof Element ? e.target.closest("summary") : null;
          if (!summary) return;

          // Don’t interfere with the product dropdown UI
          if (summary.closest(".starlight-sidebar-topics-dropdown-container")) return;

          // Navigate for clicks anywhere on the summary except the caret arrow,
          // which should only toggle the dropdown open/closed.
          const clickedCaret =
            e.target instanceof Element && e.target.closest(".caret");
          if (clickedCaret) return;

          const details = summary.parentElement;
          if (!(details instanceof HTMLDetailsElement)) return;

          // Only navigate if an overview page actually exists for this section.
          // If not, let the native toggle run so the section just opens/closes.
          const href = findOverviewHref(details);
          if (!href) return;

          // Prevent native toggle, navigate instead
          e.preventDefault();
          e.stopPropagation();
          if (typeof e.stopImmediatePropagation === "function") e.stopImmediatePropagation();

          const target = strip(href).replace(/\/$/, "");
          const current = strip(window.location.pathname).replace(/\/$/, "");

          if (target !== current) {
            details.open = true;

            // Sidebar state is saved by the astro:before-swap handler in the
            // bundled script below — no need to snapshot here manually.
            if (window.__astroNavigate) {
              window.__astroNavigate(href);
            } else {
              window.location.assign(href);
            }
          } else {
            // Already on this overview — toggle the section
            details.open = !details.open;
          }
        },
        true
      );
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", onReady, { once: true });
    } else {
      onReady();
    }
  })();
</script>

<script is:inline data-astro-rerun>
  // Ensure the section containing the current page is always expanded,
  // even after SidebarPersister restores a stale collapsed state from sessionStorage.
  (() => {
    const current = document.querySelector('nav [aria-current="page"]');
    if (!current) return;
    let el = current.closest('details');
    while (el) {
      el.open = true;
      el = el.parentElement?.closest('details') ?? null;
    }
  })();
</script>

<script>
  const OVERVIEW_SLUGS = new Set(['overview', 'Overview', 'index', 'Index']);
  const strip = (href: string) => href.split('#')[0].split('?')[0];
  const prefetchedOverviews = new Set<string>();

  // Close the TopicsDropdown when clicking outside it. Queries elements fresh
  // on each click so it always targets the current DOM after SPA swaps.
  document.addEventListener('click', (e) => {
    const menu = document.getElementById('starlight-sidebar-topics-dropdown-menu');
    const button = document.getElementById('starlight-sidebar-topics-dropdown-button');
    if (!menu || !button) return;
    const target = e.target as Element | null;
    if (target && !menu.contains(target) && !button.contains(target)) {
      menu.hidden = true;
    }
  });

  // Re-initialize the TopicsDropdown toggle on every page. Cloning the button
  // strips all prior handlers (including any added by the plugin's is:inline
  // script) so there is always exactly one toggle handler.
  //
  // stopPropagation is required because the plugin's closeDropdown closure
  // captures the original button element — after a SPA swap that reference is
  // stale, so it would immediately close the menu on every button click.
  document.addEventListener('astro:page-load', () => {
    const button = document.getElementById('starlight-sidebar-topics-dropdown-button');
    const menu = document.getElementById('starlight-sidebar-topics-dropdown-menu');
    if (!button || !menu) return;

    const clone = button.cloneNode(true) as HTMLElement;
    button.replaceWith(clone);

    clone.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.hidden = !menu.hidden;
    });

    // Pre-warm the browser cache for all product links so dropdown navigation
    // is instant even on first visit.
    menu.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
      fetch(a.href, { credentials: 'same-origin' }).catch(() => {});
    });

  });

  // Overview <a> elements are hidden (display:none), so Astro's hover-prefetch
  // never fires for them. Replicate it with <link rel="prefetch"> — same
  // mechanism Astro uses for visible links, low-priority so it doesn't compete
  // with critical resources. Deduplication guard prevents accumulating duplicate
  // tags across SPA navigations. Separate listener so this is never gated on
  // the topics dropdown being present.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLAnchorElement>('nav details a[href]').forEach((a) => {
      const parts = strip(a.getAttribute('href') || '').split('/').filter(Boolean);
      const last = parts[parts.length - 1];
      if (!last || !OVERVIEW_SLUGS.has(last)) return;
      if (prefetchedOverviews.has(a.href)) return;
      prefetchedOverviews.add(a.href);
      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.href = a.href;
      link.as = 'document';
      document.head.appendChild(link);
    });
  });

  document.addEventListener('astro:before-swap', () => {
    // Save sidebar state before every swap. Starlight's SidebarPersistState
    // holds stale DOM refs after the first SPA navigation, so we do this manually.
    try {
      const persist = document.querySelector('sl-sidebar-state-persist');
      if (!persist) return;
      const hash = (persist as HTMLElement).dataset.hash || '';
      const open: Array<boolean | null> = [];
      persist.querySelectorAll('details').forEach((d) => {
        const restore = d.querySelector('sl-sidebar-restore');
        if (restore) {
          const idx = parseInt((restore as HTMLElement).dataset.index || '');
          if (!isNaN(idx)) open[idx] = d.open;
        }
      });
      const scroller = document.getElementById('starlight__sidebar');
      sessionStorage.setItem('sl-sidebar-state', JSON.stringify({
        hash,
        open,
        scroll: scroller ? scroller.scrollTop : 0,
      }));
    } catch (err) {
      if (import.meta.env.DEV) console.warn('Sidebar state save failed:', err);
    }
  });

  // Restore sidebar state after swap. Runs before runScripts() re-executes the
  // inline scripts, so applyOverviewBehavior and expand-current operate on the
  // correct state. Also applies overview link hiding here (rather than waiting
  // for the inline script) to prevent a visible flash before first paint.
  document.addEventListener('astro:after-swap', () => {
    const currentPath = strip(window.location.pathname);
    const currentParts = currentPath.split('/').filter(Boolean);
    const currentLast = currentParts[currentParts.length - 1];
    const isOnOverview = Boolean(currentLast && OVERVIEW_SLUGS.has(currentLast));
    const normalize = (p: string) => strip(p).replace(/\/$/, '');
    document.querySelectorAll('nav a[href]').forEach((link) => {
      const href = strip(link.getAttribute('href') || '');
      const parts = href.split('/').filter(Boolean);
      const last = parts[parts.length - 1];
      if (!last || !OVERVIEW_SLUGS.has(last)) return;
      const li = link.closest('li');
      if (li) (li as HTMLElement).style.display = 'none';
      if (isOnOverview && normalize(href) === normalize(currentPath)) {
        const details = link.closest('details');
        if (details) {
          const summary = details.querySelector(':scope > summary');
          if (summary) summary.classList.add('overview-section-active');
        }
      }
    });

    // Restore sidebar open/closed state and scroll position.
    try {
      const target = document.querySelector('sl-sidebar-state-persist');
      const raw = sessionStorage.getItem('sl-sidebar-state');
      if (!target || !raw) return;
      const state = JSON.parse(raw);
      if ((target as HTMLElement).dataset.hash !== state.hash) return;
      target.querySelectorAll('sl-sidebar-restore').forEach((el) => {
        const idx = parseInt((el as HTMLElement).dataset.index || '');
        const details = el.closest('details');
        if (details && typeof state.open[idx] === 'boolean') details.open = state.open[idx];
      });
      const scroller = document.getElementById('starlight__sidebar');
      if (scroller && typeof state.scroll === 'number') scroller.scrollTop = state.scroll;
    } catch (err) {
      if (import.meta.env.DEV) console.warn('Sidebar state restore failed:', err);
    }
  });
</script>
