---
import Default from '@astrojs/starlight/components/Sidebar.astro';
import TopicsDropdown from 'starlight-sidebar-topics-dropdown/TopicsDropdown.astro';

const isPageWithTopic = Astro.locals.starlightSidebarTopics?.isPageWithTopic ?? false;
---

{/* Render the topics dropdown menu only when the page belongs to a topic. */}
{isPageWithTopic && (
  <div class="starlight-sidebar-topics-dropdown-container">
    <div class="starlight-sidebar-topics-dropdown-title">Choose a product</div>
    <TopicsDropdown />
  </div>
)}

{/* Clear persisted sidebar state BEFORE Starlight's restore script runs,
    so the sidebar always reflects the current page's tree on navigation. */}
<script is:inline>
  try { sessionStorage.removeItem("sl-sidebar-state"); } catch { /* sessionStorage may throw in private browsing */ }
</script>

{/* Render the default sidebar. */}
<Default><slot /></Default>

{/* Override the default gap in the sidebar content with higher specificity */}
<style>
  .starlight-sidebar-topics-dropdown-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .starlight-sidebar-topics-dropdown-dropdown {
    position: relative;
    display: block;
    width: calc(100% - 2 * 2px);
    margin-inline: 2px;
    margin-top: 0;
  }

  /* Override starlight-sidebar-topics-dropdown plugin styles — !important required
     because the plugin injects its own styles with high specificity. */
  :global(.starlight-sidebar-topics-dropdown-menu) {
    background-color: var(--sl-color-bg) !important;
    border: 1px solid var(--sl-color-gray-5) !important;
  }

  :global(.starlight-sidebar-topics-dropdown-button:hover) {
    background-color: var(--sl-color-gray-5) !important;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  }

  :global(.starlight-sidebar-topics-dropdown-item:hover) {
    background-color: var(--sl-color-gray-4) !important;
    transform: translateX(4px);
    border-radius: 0.25rem;
  }

  :global(nav details summary.overview-section-active),
  :global(nav details summary.overview-section-active:hover),
  :global(nav details summary.overview-section-active:focus) {
    background-color: var(--sl-color-text-accent) !important;
  }

  :global(nav details summary.overview-section-active .group-label span) {
    color: var(--sl-color-text-invert);
    font-weight: 600;
  }

</style>

<script is:inline>
  // Hide versioned topics from the product dropdown — versions use the VersionPicker instead.
  // Runs immediately so there's no flash of versioned items in the dropdown.
  // Note: version slug pattern must match VERSION_SLUG_PATTERN in productUtils.ts.
  (() => {
    const versionPattern = /\/v\d+-\d+\//;
    document.querySelectorAll('.starlight-sidebar-topics-dropdown-menu a').forEach(a => {
      if (versionPattern.test(a.getAttribute('href') || '')) {
        a.style.display = 'none';
      }
    });
  })();
</script>

<script is:inline>
  (() => {
    // Sidebar group labels (e.g. "Getting Started") navigate to the section's overview page
    // when clicked, rather than just toggling the group open/closed. This set defines which
    // URL slugs count as "overview" pages. Case variants handle renamed directories from
    // the integration script's title-casing step.
    const OVERVIEW_SLUGS = new Set(["overview", "Overview", "index", "Index"]);
    const strip = (href) => href.split("#")[0].split("?")[0];

    const isInsideNestedDetails = (detailsEl, linkEl) => {
      const closestDetails = linkEl.closest("details");
      return closestDetails && closestDetails !== detailsEl;
    };

    // Returns the overview/index href if one exists at THIS group level (including hidden items).
    // Returns null if no overview exists — callers must handle this case gracefully.
    const findOverviewHref = (detailsEl) => {
      const linkEls = Array.from(detailsEl.querySelectorAll("a[href]")).filter(
        (a) => !isInsideNestedDetails(detailsEl, a)
      );

      const hrefs = linkEls.map((a) => a.getAttribute("href")).filter(Boolean);

      for (const href of hrefs) {
        const parts = strip(href).split("/").filter(Boolean);
        const last = parts[parts.length - 1];
        if (last && OVERVIEW_SLUGS.has(last)) return href;
      }

      return null;
    };

    const applyOverviewBehavior = () => {
      const nav = document.querySelector("nav");
      if (!nav) return;
      const currentPath = strip(window.location.pathname);
      const currentParts = currentPath.split("/").filter(Boolean);
      const currentLast = currentParts[currentParts.length - 1];
      const isOnOverview = Boolean(currentLast && OVERVIEW_SLUGS.has(currentLast));
      const normalize = (p) => strip(p).replace(/\/$/, "");
      nav.querySelectorAll("a[href]").forEach((link) => {
        const href = strip(link.getAttribute("href") || "");
        const parts = href.split("/").filter(Boolean);
        const last = parts[parts.length - 1];
        if (!last || !OVERVIEW_SLUGS.has(last)) return;
        // Hide the sidebar list item for this overview link
        const li = link.closest("li");
        if (li) li.style.display = "none";
        // Highlight parent section when on this overview page
        if (isOnOverview && normalize(href) === normalize(currentPath)) {
          const details = link.closest("details");
          if (details) {
            const summary = details.querySelector(":scope > summary");
            if (summary) summary.classList.add("overview-section-active");
          }
        }
      });
    };

    // Run immediately — the nav is already in the DOM since this script
    // executes after <Default> renders the sidebar HTML. This avoids the
    // flash-of-overview-item that occurs if we wait for DOMContentLoaded.
    applyOverviewBehavior();

    const onReady = () => {
      const nav = document.querySelector("nav");
      if (!nav) return;

      // Only the label text navigates; clicking anywhere else on the row just toggles.
      // Keyboard accessible: <summary> fires click on Enter/Space natively.
      nav.addEventListener(
        "click",
        (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

          const summary = e.target instanceof Element ? e.target.closest("summary") : null;
          if (!summary) return;

          // Don’t interfere with the product dropdown UI
          if (summary.closest(".starlight-sidebar-topics-dropdown-container")) return;

          // Only navigate if the click landed on the group label text
          const clickedLabel =
            e.target instanceof Element &&
            (e.target.closest(".group-label") || e.target.classList.contains("group-label"));
          if (!clickedLabel) return;

          const details = summary.parentElement;
          if (!(details instanceof HTMLDetailsElement)) return;

          // Only navigate if an overview page actually exists for this section.
          // If not, let the native toggle run so the section just opens/closes.
          const href = findOverviewHref(details);
          if (!href) return;

          // Prevent native toggle, navigate instead
          e.preventDefault();
          e.stopPropagation();
          if (typeof e.stopImmediatePropagation === "function") e.stopImmediatePropagation();

          details.open = true;

          const target = strip(href).replace(/\/$/, "");
          const current = strip(window.location.pathname).replace(/\/$/, "");
          if (target !== current) window.location.assign(href);
        },
        true
      );
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", onReady, { once: true });
    } else {
      onReady();
    }
  })();
</script>
