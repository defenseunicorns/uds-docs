---
import Default from '@astrojs/starlight/components/Head.astro';
import PostHog from './PostHog.astro';
import { ClientRouter } from 'astro:transitions';
---

<ClientRouter />

<script>
  import { navigate } from 'astro:transitions/client';
  window.__astroNavigate = navigate;
</script>

<link rel="sitemap" href="/sitemap-index.xml" />
<script
  is:inline
  type="text/plain"
  data-category="analytics"
  data-service="Google Analytics"
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-57TRKPHZXN"
></script>
<script
  is:inline
  type="text/plain"
  data-category="analytics"
>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-57TRKPHZXN');
</script>

<PostHog/>

<Default><slot /></Default>

<script>
  function applyExternalLinks() {
    const origin = window.location.origin;
    document.querySelectorAll('main a[href]').forEach((link) => {
      const anchor = link as HTMLAnchorElement;
      // Skip non-http links (mailto:, tel:, etc.) — their anchor.origin is "null".
      if ((anchor.protocol === 'http:' || anchor.protocol === 'https:') && anchor.origin !== origin) {
        if (!anchor.hasAttribute('target')) {
          anchor.setAttribute('target', '_blank');
        }
        anchor.setAttribute('rel', 'noopener noreferrer');
      }
    });
  }
  document.addEventListener('astro:page-load', applyExternalLinks);
</script>
