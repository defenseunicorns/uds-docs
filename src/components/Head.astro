---
import Default from '@astrojs/starlight/components/Head.astro';
import PostHog from './PostHog.astro';
---

<link rel="sitemap" href="/sitemap-index.xml" />
<script
  is:inline
  type="text/plain"
  data-category="analytics"
  data-service="Google Analytics"
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-57TRKPHZXN"
></script>
<script
  is:inline
  type="text/plain"
  data-category="analytics"
>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-57TRKPHZXN');
</script>

<PostHog/>

<Default><slot /></Default>

<script>
  function applyExternalLinks() {
    const origin = window.location.origin;
    document.querySelectorAll('main a[href]').forEach((link) => {
      const anchor = link as HTMLAnchorElement;
      try {
        const url = new URL(anchor.href, window.location.href);
        if (url.origin !== origin) {
          if (!anchor.hasAttribute('target')) {
            anchor.setAttribute('target', '_blank');
          }
          anchor.setAttribute('rel', 'noopener noreferrer');
        }
      } catch { /* ignore unparseable hrefs */ }
    });
  }
  document.addEventListener('DOMContentLoaded', applyExternalLinks);
  document.addEventListener('astro:page-load', applyExternalLinks);
</script>
