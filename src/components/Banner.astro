---
// This banner renders on every page to direct users to the new docs site.
---

<div class="sl-banner" data-pagefind-ignore>
  Our docs have moved! You're viewing the legacy site.
  <a href="https://docs.defenseunicorns.com">Visit the new docs →</a>
</div>

<style>
  @layer starlight.core {
    .sl-banner {
      padding: 0.85rem var(--sl-nav-pad-x);
      background-color: #345797;
      color: #fff;
      line-height: var(--sl-line-height-headings);
      text-align: center;
      text-wrap: balance;
      font-size: 1rem;
      font-weight: 500;
      border-bottom: 1px solid #1e3a6e;
    }

    .sl-banner a {
      color: #fff;
      text-decoration: underline;
      text-underline-offset: 3px;
      font-weight: 700;
    }

    .sl-banner a:hover {
      text-decoration-thickness: 2px;
    }
  }
</style>
