---
import Default from '@astrojs/starlight/components/Search.astro';
---

<!-- Default Search Component -->
<Default />

<!-- Search filter styles (injected once server-side to avoid runtime accumulation) -->
<style is:global>
  .result-breadcrumb {
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
    margin: 0 0 0.15rem;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }
  .topic-filter-container {
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--sl-color-bg);
    border-top: 1px solid var(--sl-color-gray-5);
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  .filter-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-text);
    white-space: nowrap;
  }
  .filter-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .filter-button {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background-color: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
    font-weight: 500;
  }
  .filter-button:hover {
    border-color: var(--sl-color-gray-4);
    background-color: var(--sl-color-gray-6);
  }
  .filter-button.active {
    background-color: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
  }
  .filter-button.active:hover {
    background-color: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
    opacity: 0.9;
  }
  .filter-button:focus {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
  .no-filtered-results {
    padding: 1rem;
    text-align: center;
    color: var(--sl-color-gray-2);
    font-style: italic;
  }
  .search-loading { justify-content: center; padding: 1.5rem 0; display: none; }
  .search-loading.visible { display: flex; }
  .search-spinner {
    width: 1.25rem; height: 1.25rem;
    border: 2px solid var(--sl-color-gray-5);
    border-top-color: var(--sl-color-accent);
    border-radius: 50%;
    animation: search-spin 0.6s linear infinite;
  }
  @keyframes search-spin { to { transform: rotate(360deg); } }
  .pagefind-ui__results { transition: opacity 0.1s ease; }
  .pagefind-ui__results.loading { opacity: 0; }
  /* Version filter panel is hidden — version scoping is applied programmatically.
     Users never need to see or interact with the filter panel directly. */
  .pagefind-ui__filter-panel { display: none !important; }
</style>

<script>
  /**
   * Search component enhancement for multi-product docs.
   *
   * Layers on top of Pagefind's default search UI to provide:
   * 1. Product filter buttons (e.g. "All", "Core", "CLI") — filters results by URL prefix.
   * 2. Version scoping — activates Pagefind's native filter so only results from the
   *    current page's version are shown (latest vs archived).
   * 3. Breadcrumb injection — adds section path above each result title for context.
   * 4. Result count correction — adjusts the displayed count when product filtering
   *    hides results, including auto-loading all pages to get an accurate total.
   */
  import {
    detectMainPath,
    productHasMain,
    products as configuredProducts,
    productLatestVersions,
    VERSION_SLUG_PATTERN,
  } from '../productUtils';

  // The first product in the config is treated as the "primary" product.
  // Search results not matching any other product are assumed to belong to it.
  const primaryProduct = configuredProducts[0] ?? null;
  const primaryLabel = primaryProduct?.label ?? '';
  const otherProducts = configuredProducts.slice(1);

  // Detect the product the user is currently viewing from the page URL.
  // Returns the product label (e.g. "Core", "CLI") or '' for the root/all pages.
  function detectDefaultFilter(): string {
    const path = window.location.pathname;
    const matched = otherProducts.find(p => path.startsWith(p.link));
    if (matched) return matched.label;
    if (primaryProduct && path.startsWith(primaryProduct.link)) return primaryProduct.label;
    return '';
  }

  let currentFilter = detectDefaultFilter();

  // The original total count string from Pagefind before any filtering modification.
  // Saved on first product-filtered render, reset when the user starts a new search.
  let savedPagefindCount: string | null = null;

  // When true, the observer uses a near-zero debounce to rapidly exhaust load-more batches.
  let autoLoadingForCount = false;

  // Detect the version the user is currently viewing from the page URL.
  // MAIN pages use "main"; all latest release pages share "latest" so the
  // search scope works across products with different release numbers.
  // Non-product pages use the latest release scope as well.
  function detectPageVersion(path: string): string {
    const product = configuredProducts.find(p => path.startsWith(p.link));
    if (!product) return 'latest';
    if (detectMainPath(path, product)) return 'main';
    const hasMain = productHasMain[product.id] === true;
    const usesLatestRelease = hasMain || product.latestSource === null;
    const segs = path.split('/');
    for (const seg of segs) {
      if (VERSION_SLUG_PATTERN.test(seg)) {
        return usesLatestRelease && productLatestVersions[product.id]?.slug === seg ? 'latest' : seg;
      }
    }
    return usesLatestRelease && productLatestVersions[product.id] ? 'latest' : 'current';
  }

  let pageVersion = detectPageVersion(window.location.pathname);

  // Track active observer/timer so they can be cleaned up on navigation.
  let activeObserver: MutationObserver | null = null;
  let waitTimer: ReturnType<typeof setTimeout> | undefined;

  // Set to true by astro:before-swap to detect SPA navigations in astro:page-load.
  let pendingSpaPagefindInit = false;

  // ID of any pending requestIdleCallback (or setTimeout fallback) for PagefindUI init.
  // Cancelled in astro:before-swap to prevent stale callbacks from firing against new DOM.
  let pendingIdleId: number | null = null;

  // The active PagefindUI instance. Stored so we can attempt teardown before re-init.
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  let pagefindInstance: any = null;

  // Clean up stale observer, retry timer, and pending idle callback before each swap.
  // Without this, detached DOM trees would be kept alive by the old observer, and a
  // stale idle callback from a previous navigation could fire against the new DOM.
  document.addEventListener('astro:before-swap', () => {
    clearTimeout(waitTimer);
    if (activeObserver) {
      activeObserver.disconnect();
      activeObserver = null;
    }
    if (pendingIdleId !== null) {
      if (window.cancelIdleCallback) {
        window.cancelIdleCallback(pendingIdleId);
      } else {
        clearTimeout(pendingIdleId);
      }
      pendingIdleId = null;
    }
    pagefindInstance?.destroy?.();
    pagefindInstance = null;
    pendingSpaPagefindInit = true;
  });

  // Initialize topic filter functionality.
  // Uses astro:page-load (fires on both initial MPA load and Client Router SPA navigations)
  // so the search filter re-initializes correctly when navigating between products.
  document.addEventListener('astro:page-load', () => {
    // Re-detect product/version for the current page after SPA navigation
    currentFilter = detectDefaultFilter();
    pageVersion = detectPageVersion(window.location.pathname);
    savedPagefindCount = null;
    autoLoadingForCount = false;

    // Defined here (before the SPA block) so the onIdle closure can reference it.
    // On the SPA path it is called from inside onIdle after PagefindUI mounts,
    // guaranteeing the form element exists when polling starts.
    // On the initial load path it is called directly at the end of this handler.
    let retries = 0;
    const waitForPagefindUI = () => {
      const pagefindForm = document.querySelector('.pagefind-ui__form');
      if (pagefindForm) {
        injectTopicFilter(pagefindForm);
        setupFilterBehavior(pagefindForm);
      } else if (retries++ < 50) {
        waitTimer = setTimeout(waitForPagefindUI, 100);
      } else {
        console.warn('Search: Pagefind UI form not found after 5s — product filter not injected.');
      }
    };

    // WORKAROUND for upstream Starlight bug: the SiteSearch custom element constructor
    // initializes PagefindUI inside window.addEventListener('DOMContentLoaded', ...), but
    // DOMContentLoaded never re-fires after ClientRouter SPA swaps. We initialize directly.
    //
    // This mirrors the DOMContentLoaded handler in @astrojs/starlight Search.astro
    // (SiteSearch constructor, lines 135-158). Must be kept in sync with upstream on
    // Starlight upgrades.
    //
    // NOTE: pagefindUserConfig from 'virtual:starlight/pagefind-config' is not spread here
    // because the virtual module type declarations are inaccessible in this component override
    // context. This is safe as long as no pagefind options are set in astro.config.mjs. If
    // custom pagefind config is ever added there, this block must be updated to include it
    // or SPA search will silently diverge from initial-load search behavior.
    if (pendingSpaPagefindInit && !import.meta.env.DEV) {
      pendingSpaPagefindInit = false;
      const siteSearch = document.querySelector<HTMLElement>('site-search');
      if (siteSearch) {
        const shouldStrip = siteSearch.dataset.stripTrailingSlash !== undefined;
        const stripTrailingSlash = (path: string) => path.replace(/(.)\/(#.*)?$/, '$1$2');
        const formatURL = shouldStrip ? stripTrailingSlash : (path: string) => path;
        let translations: Record<string, string> = {};
        try {
          translations = JSON.parse(siteSearch.dataset.translations || '{}');
        } catch (e) {
          console.warn('Search: failed to parse translations from site-search element:', e);
        }
        // Use requestIdleCallback with a 2s timeout so the callback is guaranteed to fire
        // within the waitForPagefindUI polling window (5s) even under CPU pressure.
        const scheduleInit = (cb: () => void): number =>
          window.requestIdleCallback
            ? window.requestIdleCallback(cb as IdleRequestCallback, { timeout: 2000 })
            : window.setTimeout(cb, 1);
        pendingIdleId = scheduleInit(async () => {
          pendingIdleId = null;
          // @ts-expect-error — Missing types for @pagefind/default-ui package.
          const { PagefindUI } = await import('@pagefind/default-ui');
          pagefindInstance = new PagefindUI({
            element: '#starlight__search',
            baseUrl: import.meta.env.BASE_URL,
            bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
            showImages: false,
            translations,
            showSubResults: true,
            processResult: (result: { url: string; sub_results: Array<{ url: string }> }) => {
              result.url = formatURL(result.url);
              result.sub_results = result.sub_results.map((sub_result) => {
                sub_result.url = formatURL(sub_result.url);
                return sub_result;
              });
            },
          });
          // Call waitForPagefindUI here — after PagefindUI has mounted — to guarantee
          // the form element exists when polling starts, eliminating the race condition.
          waitForPagefindUI();
        });
      } else {
        console.warn('Search: <site-search> element not found after SPA navigation — PagefindUI not initialized.');
      }
      return;
    }

    // Initial page load: upstream SiteSearch DOMContentLoaded handler initializes PagefindUI.
    // Poll until it mounts so the topic filter and filter behavior can be injected.
    waitForPagefindUI();
  });

  function injectTopicFilter(pagefindForm: Element) {
    if (pagefindForm.querySelector('.topic-filter-container')) return;

    const availableTopics = detectAvailableTopics();

    if (availableTopics.length <= 1) {
      return;
    }

    const filterContainer = document.createElement('div');
    filterContainer.className = 'topic-filter-container';

    const filterLabel = document.createElement('span');
    filterLabel.textContent = 'Filter Docs: ';
    filterLabel.className = 'filter-label';

    const filterButtonsContainer = document.createElement('div');
    filterButtonsContainer.className = 'filter-buttons';

    const topicEntries: [string, string][] = [
      ['', 'All'],
      ...availableTopics.map(label => [label, label] as [string, string]),
    ];

    topicEntries.forEach(([value, label]) => {
      const button = document.createElement('button');
      button.textContent = label;
      button.className = `filter-button${currentFilter === value ? ' active' : ''}`;

      button.addEventListener('click', () => {
        filterButtonsContainer.querySelectorAll('.filter-button').forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');
        currentFilter = value;
        applyProductFilter();
      });

      filterButtonsContainer.appendChild(button);
    });

    filterContainer.appendChild(filterLabel);
    filterContainer.appendChild(filterButtonsContainer);

    const searchInput = pagefindForm.querySelector('.pagefind-ui__search-input');
    if (searchInput) {
      searchInput.parentNode?.insertBefore(filterContainer, searchInput.nextSibling);
    } else {
      pagefindForm.appendChild(filterContainer);
    }
  }

  function detectAvailableTopics(): Array<string> {
    const dropdown = document.querySelector('.starlight-sidebar-topics-dropdown-menu');
    const visibleOther = otherProducts.filter(p => {
      if (!dropdown) return true;
      return dropdown.querySelector(`a[href="${p.link}"]`) !== null;
    });

    if (visibleOther.length === 0) return [];

    return [primaryLabel, ...visibleOther.map(p => p.label)];
  }

  function setupFilterBehavior(pagefindForm: Element) {
    const pagefindContainer = (pagefindForm.closest('.pagefind-ui') ?? pagefindForm.parentElement ?? pagefindForm) as HTMLElement;

    const loadingEl = document.createElement('div');
    loadingEl.className = 'search-loading';
    loadingEl.innerHTML = '<div class="search-spinner" aria-hidden="true"></div>';
    pagefindContainer.appendChild(loadingEl);

    const searchInput = pagefindForm.querySelector('.pagefind-ui__search-input') as HTMLInputElement | null;
    searchInput?.addEventListener('input', () => {
      // New search query — reset all filter state for the new term.
      savedPagefindCount = null;
      autoLoadingForCount = false;
      if (searchInput.value.trim()) {
        const resultsEl = pagefindContainer.querySelector('.pagefind-ui__results') as HTMLElement | null;
        if (resultsEl) resultsEl.classList.add('loading');
        loadingEl.classList.add('visible');
      } else {
        loadingEl.classList.remove('visible');
      }
    });

    let isInjecting = false;
    let filterTimer: ReturnType<typeof setTimeout> | undefined;

    activeObserver = new MutationObserver(() => {
      if (isInjecting) return;
      clearTimeout(filterTimer);
      // During auto-loading for count, use a near-zero delay so batches are consumed rapidly.
      // For normal search renders, keep the 50ms debounce to avoid processing partial updates.
      const delay = autoLoadingForCount ? 5 : 50;
      filterTimer = setTimeout(() => {
        isInjecting = true;
        // Skip expensive per-result work (breadcrumbs, version filter) during auto-loading —
        // only applyProductFilter matters at that point.
        if (!autoLoadingForCount) {
          injectBreadcrumbs();
          // Activate the native pagefind version filter. If it wasn't already checked,
          // pagefind re-runs the search — the next observer fire will show results.
          const willRerun = activateVersionFilter(pagefindContainer);
          if (willRerun) {
            isInjecting = false;
            return;
          }
        }
        applyProductFilter();
        const resultsEl = pagefindContainer.querySelector('.pagefind-ui__results') as HTMLElement | null;
        if (resultsEl) resultsEl.classList.remove('loading');
        loadingEl.classList.remove('visible');
        isInjecting = false;
      }, delay);
    });

    activeObserver.observe(pagefindContainer, { childList: true, subtree: true });
  }

  /**
   * Build a breadcrumb string from a search result href.
   * Strips the product prefix and version slug, then title-cases each segment.
   * Uses non-breaking space (\u00a0) within segments and › (\u203a) as separator.
   * e.g. "/core/getting-started/local-demo/overview/" → "Getting\u00a0Started › Local\u00a0Demo"
   */
  function formatBreadcrumb(href: string): string {
    let stripped = href;
    // Strip product prefix (any product, including primary) so breadcrumbs are section-relative
    for (const p of configuredProducts) {
      if (stripped.startsWith(p.link)) {
        stripped = '/' + stripped.slice(p.link.length);
        break;
      }
    }
    // Strip version slug segment if present (e.g. /v0-62/)
    stripped = stripped.replace(/^\/(v\d+-\d+)\//, '/');
    const parts = stripped.replace(/^\/|\/$/g, '').split('/');
    // Drop the last segment (the page itself) — breadcrumbs show the path to it
    const sectionParts = parts.slice(0, -1);
    if (sectionParts.length === 0) return '';
    return sectionParts
      .map(part => part.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join('\u00a0'))
      .join(' \u203a ');
  }

  function injectBreadcrumbs() {
    document.querySelectorAll('.pagefind-ui__result').forEach(result => {
      if (result.querySelector('.result-breadcrumb')) return;

      const link = result.querySelector('a');
      if (!link) return;

      const href = link.getAttribute('href') || '';
      const breadcrumb = formatBreadcrumb(href);
      if (!breadcrumb) return;

      const breadcrumbEl = document.createElement('p');
      breadcrumbEl.className = 'result-breadcrumb';
      breadcrumbEl.textContent = breadcrumb;

      const title = result.querySelector('.pagefind-ui__result-title');
      if (title) {
        title.parentNode?.insertBefore(breadcrumbEl, title);
      }
    });
  }

  // Activate the native pagefind version filter for the current page's version.
  // Returns true if the filter was just applied (pagefind will re-run the search);
  // returns false if it was already active or the filter panel isn't available yet.
  function activateVersionFilter(container: HTMLElement): boolean {
    const input = container.querySelector(
      `.pagefind-ui__filter-panel input[value="${pageVersion}"]`
    ) as HTMLInputElement | null;
    if (!input || input.checked) return false;
    input.click();
    return true;
  }

  // Apply the active product filter (Core/CLI buttons) via DOM hiding.
  // Version filtering is handled natively by pagefind; this only handles product scope.
  function applyProductFilter() {
    const results = document.querySelectorAll('.pagefind-ui__result');
    let visibleCount = 0;

    results.forEach(result => {
      const link = result.querySelector('a');
      if (link) {
        const href = link.getAttribute('href') || '';
        const visible = !currentFilter || isResultMatchingFilter(href, currentFilter);
        (result as HTMLElement).style.display = visible ? '' : 'none';
        if (visible) visibleCount++;
      }
    });

    if (!currentFilter) {
      // "All" — restore the original Pagefind total count if we previously modified it.
      autoLoadingForCount = false;
      if (savedPagefindCount !== null && results.length > 0) {
        setResultCount(savedPagefindCount);
      }
      removeNoResultsMessage();
      return;
    }

    // A product filter is active — save the native total before we change it.
    capturePagefindCount();

    const loadMoreBtn = findLoadMoreButton();
    if (loadMoreBtn) {
      // More results exist — show "…" immediately so the user never sees the wrong total,
      // then keep loading until all results are in the DOM.
      // autoLoadingForCount reduces the observer debounce to 5ms for fast batch throughput.
      setResultCount('\u2026');
      autoLoadingForCount = true;
      loadMoreBtn.click();
      return;
    }

    // All available results are loaded — inject breadcrumbs for any results that were added
    // during auto-loading (the observer skipped injectBreadcrumbs while autoLoadingForCount
    // was true), then update the count to the true filtered total.
    autoLoadingForCount = false;
    injectBreadcrumbs();
    setResultCount(visibleCount);

    if (results.length > 0 && visibleCount === 0) {
      showNoResultsMessage(currentFilter);
    } else {
      removeNoResultsMessage();
    }
  }

  // Save the original Pagefind result count string (e.g. "42") before we modify it.
  function capturePagefindCount() {
    if (savedPagefindCount !== null) return;
    const msg = document.querySelector('.pagefind-ui__message:not(.no-filtered-results)');
    if (msg) {
      const match = (msg.textContent || '').match(/\d[\d,]*/);
      if (match) savedPagefindCount = match[0];
    }
  }

  // Returns the Pagefind "load more" button if it is currently rendered.
  function findLoadMoreButton(): HTMLButtonElement | null {
    return document.querySelector('.pagefind-ui__button') as HTMLButtonElement | null;
  }

  // Replace the count in the Pagefind message with any value: a number, saved string, or "…".
  function setResultCount(count: string | number) {
    document.querySelectorAll('.pagefind-ui__message:not(.no-filtered-results)').forEach(msg => {
      msg.textContent = (msg.textContent || '').replace(/\d[\d,]*|\u2026/, String(count));
    });
  }

  function isResultMatchingFilter(href: string, filter: string): boolean {
    const matched = otherProducts.find(p => p.label === filter);
    if (matched) return href.startsWith(matched.link);
    if (filter === primaryLabel) return !otherProducts.some(p => href.startsWith(p.link));
    return true;
  }

  function showNoResultsMessage(filter: string) {
    const resultsContainer = document.querySelector('.pagefind-ui__results');
    if (resultsContainer && !resultsContainer.querySelector('.no-filtered-results')) {
      const noResultsMsg = document.createElement('div');
      noResultsMsg.className = 'pagefind-ui__message no-filtered-results';
      noResultsMsg.textContent = `No results found in "${filter}"`;
      resultsContainer.appendChild(noResultsMsg);
    }
  }

  function removeNoResultsMessage() {
    const noResultsMsg = document.querySelector('.no-filtered-results');
    if (noResultsMsg) {
      noResultsMsg.remove();
    }
  }
</script>
