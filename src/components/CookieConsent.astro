---
import 'vanilla-cookieconsent/dist/cookieconsent.css';
---
<a type="button" class="footer-link" href="#" data-cc="show-preferencesModal">Cookie Settings</a>

<script>
    import { run } from 'vanilla-cookieconsent';

    document.documentElement.classList.add('cc--darkmode');

    /**
     * All config. options available here:
     * https://cookieconsent.orestbida.com/reference/configuration-reference.html
     */
    run({

        guiOptions: {
            consentModal: {
                layout: 'box inline',
                position: 'bottom right',
                equalWeightButtons: true,
                flipButtons: false
            },
            preferencesModal: {
                layout: 'box',
                equalWeightButtons: true,
                flipButtons: false
            }
        },

        categories: {
            necessary: {
                enabled: true,  // this category is enabled by default
                readOnly: true  // this category cannot be disabled
            },
            analytics: {}
        },

        language: {
            default: 'en',
            translations: {
                en: {
                    consentModal: {
                        title: 'Cookie Settings',
                        description: 'Cookies may be used by Defense Unicorns, Inc. to collect Non-personally Identifiable Information regarding site users to aid in improving our developer experience. This website uses Google Analytics and PostHog.',
                        acceptAllBtn: 'Accept all',
                        acceptNecessaryBtn: 'Reject all',
                        showPreferencesBtn: 'Manage individual preferences'
                    },
                    preferencesModal: {
                        title: 'Manage cookie preferences',
                        acceptAllBtn: 'Accept all',
                        acceptNecessaryBtn: 'Reject all',
                        savePreferencesBtn: 'Accept current selection',
                        closeIconLabel: 'Close modal',
                        sections: [
                            {
                                title: 'About cookie usage',
                                description: 'Cookies may be used by Defense Unicorns, Inc. to collect Non-personally Identifiable Information regarding site users to aid in improving our developer experience. This website uses Google Analytics and PostHog.'
                            },
                            {
                                title: 'Strictly Necessary cookies',
                                description: 'These cookies are essential for the proper functioning of the website and cannot be disabled.',

                                //this field will generate a toggle linked to the 'necessary' category
                                linkedCategory: 'necessary'
                            },
                            {
                                title: 'Performance and Analytics',
                                description: 'These cookies collect information about how you use our website. All of the data is anonymized and cannot be used to identify you.',
                                linkedCategory: 'analytics'
                            },
                            {
                                title: 'More information',
                                description: 'Please <a href="https://defenseunicorns.com/legal/privacypolicy" target="_blank">view our company privacy policy</a> or <a href="https://www.defenseunicorns.com/contactus" target="_blank">contact us</a> for more information.'
                            }
                        ]
                    }
                }
            }
        }
    });

    // Preserve cookie consent across Client Router page swaps.
    // Two things must survive: the #cc-main DOM element and the CSS classes on <html>
    // (show--consent, show--preferences, cc--darkmode) that control modal visibility.
    // swapRootAttributes replaces all <html> attributes from the new document, so we
    // copy cookie consent classes to the new doc before the swap to preserve them.
    document.addEventListener('astro:before-swap', (e) => {
        const newDoc = (e as Event & { newDocument: Document }).newDocument;

        // Copy cookie consent classes to new document's <html> so swapRootAttributes keeps them.
        // Snapshot the classList first — it's a live DOMTokenList.
        const classes = [...document.documentElement.classList];
        for (const cls of classes) {
            if (cls.startsWith('cc--') || cls.startsWith('show--')) {
                newDoc.documentElement.classList.add(cls);
            }
        }

        // Move #cc-main out of <body> before the swap destroys it.
        // IMPORTANT: #cc-main is a direct child of <html> only between before-swap and
        // after-swap. vanilla-cookieconsent's CSS uses #cc-main directly (not body > #cc-main),
        // so this temporary reparenting does not break styles.
        const ccMain = document.getElementById('cc-main');
        if (ccMain) document.documentElement.appendChild(ccMain);
    });

    document.addEventListener('astro:after-swap', () => {
        // Move #cc-main back into <body>
        const ccMain = document.getElementById('cc-main');
        if (ccMain && ccMain.parentElement === document.documentElement) {
            document.body.appendChild(ccMain);
        }
    });
</script>
