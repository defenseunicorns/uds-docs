{
  "name": "uds-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "tsx src/build/integration.ts && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run && npm run test:e2e",
    "test:e2e": "npm run build && playwright test tests/*.spec.ts",
    "test:e2e:ui": "npm run build && playwright test --ui tests/*.spec.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^7.0.0",
    "@astrojs/react": "^5.0.0",
    "@astrojs/starlight": "^0.38.0",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@fontsource/teko": "^5.1.1",
    "@tailwindcss/vite": "^4.1.4",
    "astro": "^6.0.0",
    "sharp": "^0.34.0",
    "starlight-github-alerts": "^0.2.0",
    "starlight-image-zoom": "^0.14.0",
    "starlight-links-validator": "^0.24.0",
    "starlight-llms-txt": "^0.8.0",
    "starlight-sidebar-topics": "^0.7.0",
    "starlight-sidebar-topics-dropdown": "^0.6.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.7.3",
    "unist-util-visit": "^5.1.0",
    "vanilla-cookieconsent": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "likec4": "^1.42.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "vite": "^7.3.1"
  }
}
